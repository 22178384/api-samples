# Copy to .env and fill in real values. Never commit .env.
#   cp examples/.env.example .env
#
# The scripts call load_dotenv() themselves, so no shell export needed.

# AnySearch API — get one at https://anysearch.dev (free tier is 1k req/day)
ANYSEARCH_KEY=YOUR_ANYSEARCH_KEY

# Optional: override the query used by anysearch/stream.py
QUERY=asyncio task group example

# OAuth2 (auth/oauth_example.py). Register an app with your provider to get these.
OAUTH_CLIENT_ID=YOUR_CLIENT_ID
OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
OAUTH_REDIRECT_URI=http://localhost:8000/callback

# Generic API key, used by a few ad-hoc snippets
API_KEY=YOUR_API_KEY
